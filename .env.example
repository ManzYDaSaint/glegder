# ==============================================================================
# Glegder Environment Configuration
# Note: In Expo, client-accessible environment variables must start with 'EXPO_PUBLIC_'
# ==============================================================================

# Remote Sync Backend (e.g. Supabase, Firebase, or your Custom REST API)
# When configured, records created offline ("alibe bundle") will auto-sync here once online.
EXPO_PUBLIC_SYNC_API_URL=https://api.glegder.app/v1
EXPO_PUBLIC_SYNC_API_KEY=your_sync_api_key_here

# Optional: Supabase configuration (if using Supabase as the backend sync engine)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Currency Configuration (Default: MWK - Malawian Kwacha)
EXPO_PUBLIC_DEFAULT_CURRENCY=MWK

# Telcomw OTP SMS Configuration
EXPO_PUBLIC_OTP_SMS_API_KEY=your_telcomw_api_key_here
EXPO_PUBLIC_TELCOMW_BASE_URL=https://telcomw.com
EXPO_PUBLIC_TELCOMW_SENDER_ID=Glegder
