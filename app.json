{
  "expo": {
    "name": "Glegder",
    "slug": "glegder",
    "version": "1.0.0",
    "scheme": "glegder",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nyangazie.glegder"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 1000,
      "url": "https://u.expo.dev/34be7ded-978a-4e37-a6c6-a85c45b52e3b"
    },
    "plugins": [
      "expo-router",
      [
        "expo-updates",
        {}
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "34be7ded-978a-4e37-a6c6-a85c45b52e3b"
      }
    },
    "owner": "nyangazie"
  }
}
